$TTL 3600
$ORIGIN example.org.
; A comment line
@ IN SOA ( ns1.example.org.
           hostmaster.example.org.
           2024010101  ; serial
           7200        ; refresh
           3600        ; retry
           1209600     ; expire
           3600 )      ; minimum
@   IN  NS  ns1.example.org.
ns1 IN  A   192.0.2.53 ; trailing comment
multi IN TXT "a"
              "b"
              "c"
